      "Replication": "Disabled",
      "Code": "import clr\nclr.AddReference('ProtoGeometry')\nclr.AddReference('DSCoreNodes')\nclr.AddReference('GeometryColor')\nfrom Autodesk.DesignScript.Geometry import Point, Vector, CoordinateSystem, Cuboid, Cylinder, Polygon, Arc, Circle, Solid\nfrom DSCore import Color\nfrom Modifiers import GeometryColor\n\n\ndef value(data, key):\n    return data.ValueAtKey(key) if hasattr(data, 'ValueAtKey') else data[key]\n\n\nOUT = []\ntry:\n    specs = value(IN[0], 'shape_specs')\n    rgb = value(IN[0], 'color_rgb')\nexcept (KeyError, TypeError):\n    specs = []\n    rgb = [25, 25, 25]\ncolor = Color.ByARGB(255, int(rgb[0]), int(rgb[1]), int(rgb[2]))\nfor spec in specs or []:\n    try:\n        part_rgb=value(spec,'color')\n    except KeyError:\n        part_rgb=rgb\n    color=Color.ByARGB(255,*[int(c) for c in part_rgb])\n    kind = value(spec, 'kind')\n    if kind == 'loft':\n        sections=[Polygon.ByPoints([Point.ByCoordinates(*[float(v) for v in p]) for p in section])\n                  for section in value(spec,'sections')]\n        geometry=Solid.ByLoft(sections)\n    elif kind == 'sweep':\n        start,mid,end=[Point.ByCoordinates(*[float(v) for v in value(spec,k)]) for k in ('start','mid','end')]\n        # Dynamo expects sequential points; Revit Arc.Create uses start/end/mid.\n        path=Arc.ByThreePoints(start,mid,end)\n        if path.EndPoint.DistanceTo(end) > 0.01:\n            raise ValueError('Arc endpoint mismatch: '+str(value(spec,'name')))\n        profile=Circle.ByCenterPointRadiusNormal(start,float(value(spec,'size')),path.TangentAtParameter(0.0))\n        geometry=Solid.BySweep(profile,path)\n    elif kind == 'polygon':\n        points = [Point.ByCoordinates(*[float(v) for v in p]) for p in value(spec, 'points')]\n        direction = Vector.ByCoordinates(*[float(v)*float(value(spec, 'depth')) for v in value(spec, 'axis')])\n        geometry = Polygon.ByPoints(points).ExtrudeAsSolid(direction)\n    elif kind == 'box':\n        center = Point.ByCoordinates(*[float(v) for v in value(spec, 'center')])\n        sx, sy, sz = [float(v) for v in value(spec, 'size')]\n        geometry = Cuboid.ByLengths(center, sx, sy, sz)\n    else:\n        start = Point.ByCoordinates(*[float(v) for v in value(spec, 'start')])\n        end = Point.ByCoordinates(*[float(v) for v in value(spec, 'end')])\n        size = float(value(spec, 'size'))\n        if kind in ('cylinder', 'ring'):\n            geometry = Cylinder.ByPointsRadius(start, end, size)\n            if kind == 'ring':\n                hole = Cylinder.ByPointsRadius(start, end, float(value(spec, 'inner')))\n                geometry = geometry.Difference(hole)\n        else:\n            direction = Vector.ByTwoPoints(start, end)\n            axis = direction.Normalized()\n            reference = Vector.ZAxis() if abs(axis.Z) < 0.9 else Vector.YAxis()\n            u = axis.Cross(reference).Normalized()\n            v = axis.Cross(u).Normalized()\n            midpoint = Point.ByCoordinates((start.X+end.X)/2, (start.Y+end.Y)/2, (start.Z+end.Z)/2)\n            cs = CoordinateSystem.ByOriginVectors(midpoint, u, v, axis)\n            geometry = Cuboid.ByLengths(cs, size, size, direction.Length)\n    OUT.append(GeometryColor.ByGeometryColor(geometry, color))\n",
      "Description": "Black AirBike geometry from the same shape specifications used to create the Revit family."
    },
